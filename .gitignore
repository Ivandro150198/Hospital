# Arquivos de configuração com informações sensíveis
# É uma boa prática criar um arquivo de exemplo (ex: enviar-email.php.example)
# com a estrutura, e adicionar o arquivo real ao .gitignore.
enviar-email.php

# Pastas de dependências (ex: se usar Node.js no futuro)
node_modules/

# Arquivos de log
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Pastas de configuração de IDEs e editores de código
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Arquivos gerados pelo sistema operacional
.DS_Store
Thumbs.db
